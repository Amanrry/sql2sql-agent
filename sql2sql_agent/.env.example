# OpenRouter API配置
OPENROUTER_API_KEY=sk-yandggkqnosrspklnhbgmyitdsoanhzqftbglbqvdhhmbymh
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# LLM模型配置
LLM_MODEL=deepseek/deepseek-chat-v3.1:free
LLM_TEMPERATURE=0.1

# 嵌入模型配置（用于查询相似度计算）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-yandggkqnosrspklnhbgmyitdsoanhzqftbglbqvdhhmbymh
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1

# Tavily搜索API配置
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith追踪配置（可选，用于监控Agent执行过程）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# SQLite数据库路径
SQLITE_DB_PATH=D:\Dev Project\mimic_iv\mimic_iv.sqlite
SQLITE_MCP_PATH=D:\Dev Project\mimic_iv\sqlite

# 系统配置
MAX_ITERATIONS=3
MAX_SQL_RETRIES=5
AGENT_RECURSION_LIMIT=100

# 查询评分配置
# 自适应评分阈值：查询数<=此值时直接用LLM评分，>此值时用嵌入向量+LLM混合评分
ADAPTIVE_SCORING_THRESHOLD=5
# 相似度阈值：用于去重，查询词汇重叠率>此值视为重复
SIMILARITY_THRESHOLD=0.7

# 动态停止条件配置
# 新颖性阈值：最近查询新颖性<此值时停止迭代
NOVELTY_THRESHOLD=0.3

# 查询评分过滤配置
# 最低评分阈值：查询评分>=此值才会执行，<此值时停止迭代
MIN_SCORE_THRESHOLD=0.1
